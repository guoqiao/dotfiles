#!/usr/bin/env bash
set -euo pipefail

dir_name="$(basename "$PWD")"
# Replace characters that can break tmux session names.
session_name="${dir_name//[^a-zA-Z0-9_.-]/_}"

# = here for exact match, otherwise will match prefix
if tmux has-session -t ="$session_name" 2>/dev/null; then
  exec tmux attach-session -t "$session_name"
else
  exec tmux new-session -s "$session_name"
fi
